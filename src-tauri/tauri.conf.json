{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "黑猫",
  "version": "0.1.48",
  "identifier": "com.dbscout.workbench",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "黑猫",
        "width": 1280,
        "height": 820,
        "maximized": true,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "dragDropEnabled": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "resources/agent-runner.mjs": "agent-runner.mjs",
      "resources/mcp-server.mjs": "mcp-server.mjs",
      "resources/agent-auth*.json": ".",
      "resources/svn/**/*": "svn/"
    }
  }
}
