{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB Scout Workbench",
  "version": "0.1.0",
  "identifier": "com.dbscout.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DB Scout Workbench",
        "width": 1280,
        "height": 820,
        "maximized": true,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "dragDropEnabled": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
