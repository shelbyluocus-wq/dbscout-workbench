[Unit]
Description=Blackcat (DB Scout Workbench) Central Audit Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/blackcat-server
Environment=DBSCOUT_SERVER_BIND=0.0.0.0:8765
Environment=DBSCOUT_SERVER_DB=/home/blackcat-server/data/dbscout-server.sqlite
Environment=DBSCOUT_SERVER_MAX_REVISIONS_PER_TABLE=0
Environment=DBSCOUT_SERVER_AUDIT_DETAILED_DAYS=14
Environment=DBSCOUT_SERVER_AUDIT_DAILY_DAYS=180
Environment=DBSCOUT_SERVER_COMPACT_TIME=02:00
Environment=DBSCOUT_SERVER_GM_BACKUP_DIR=/home/servbin/dbback
Environment=DBSCOUT_SERVER_TABLE_BACKUP_DIR=/home/blackcat-server/table-backups
Environment=DBSCOUT_SERVER_TABLE_BACKUP_MAX_VERSIONS=60
Environment=DBSCOUT_SERVER_TABLE_BACKUP_TIME=01:15
Environment=RUST_LOG=dbscout_server=info,tower_http=info
ExecStart=/home/blackcat-server/bin/dbscout-server
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
