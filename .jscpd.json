{
  "threshold": 5,
  "minLines": 5,
  "minTokens": 50,
  "maxLines": 10000,
  "maxSize": "2mb",
  "mode": "mild",
  "reporters": ["console"],
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "**/.worktrees/**",
    "**/output/**",
    "**/*.test.js",
    "**/*.test.mjs",
    "**/tests/**",
    "src-tauri/resources/**"
  ]
}
